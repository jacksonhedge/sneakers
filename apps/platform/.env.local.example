NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — waitlist confirmation emails. If unset, emails are silently skipped.
# Get a key at https://resend.com (free tier: 100/day, 3k/mo).
RESEND_API_KEY=
# Optional custom From address. Requires DNS records set up at Resend for the domain.
# Fallback sender is "Sneakers Terminal <onboarding@resend.dev>" which works without DNS.
WAITLIST_FROM_EMAIL=

# At-rest encryption key for user_provider_keys.api_key_encrypted (BYO LLM
# keys). Must decode to exactly 32 bytes (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, secrets are stored as plaintext (with a startup warning) — fine
# for dev, NEVER in prod.
PROVIDER_KEY_ENCRYPTION_KEY=

# Dev-only escape hatch for testing the auth flow without depending on email
# delivery. When set to "1", /api/auth/login + /api/auth/request-link return
# the magic-link URL in the response body as `devLink`. NEVER set this in
# production — anyone calling the endpoint would get a sign-in URL for any
# email they submit.
AUTH_DEV_RETURN_LINK=

# Stripe publishable key (test mode) — client-side, used by @stripe/stripe-js
# for the /roundup-demo bank-link flow (Financial Connections). Get it from
# the Stripe dashboard, test mode, API keys page, alongside whatever
# STRIPE_SECRET_KEY this repo already uses for the billing flow.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Round-up portal — Polymarket facilitation mode (Milestone 2). Optional; if
# unset, the portal defaults to wallet-move facilitation (Milestone 1).
# ROUNDUP_FACILITATION_MODE=polymarket
# ROUNDUP_POLYMARKET_MARKET_ID=

# Home page band for the Spare Change Millionaire newsletter (links to
# /spare-change). Shown only when this is exactly "on"; anything else, or
# unset, hides it. Read at build time, so redeploy after changing it. The
# /spare-change page itself exists either way (unlinked, noindex).
NEXT_PUBLIC_SPARE_CHANGE=

# Spare Change Millionaire welcome email + free-dollar claim page. All optional.
# The welcome email goes out through RESEND_API_KEY above; with no key the
# signup still works and the page says the email is "on its way shortly".
#
# Whole From line for the welcome email, e.g. The Hedge Team <hello@your-domain>.
# Unset, it is "The Hedge Team" at the WAITLIST_FROM_EMAIL address.
SPARE_CHANGE_FROM=
# Inbox that replies go to (people reply STOP, or to fix a Venmo username).
# Set it whenever the From address is not an inbox somebody reads.
SPARE_CHANGE_REPLY_TO=
# Street address printed in the email footer after "Hedge, Inc.,". Unset, the
# footer says just "Hedge, Inc.". Required (CAN-SPAM) before sending at scale.
SPARE_CHANGE_POSTAL_ADDRESS=
# How many free dollars can be claimed in this round. Default 100; 0 closes it.
SPARE_CHANGE_CLAIM_CAP=
# The claim link in the email is built from NEXT_PUBLIC_SITE_URL when set
# (the same variable the other emails use); otherwise from the request's own
# host when that is sneakersterminal.com or local, else https://sneakersterminal.com.

# Spare Change Millionaire backend: issues, tickets, tracked links, slips, rewards
# (migration 049, tables sc_*). It records wagers people place elsewhere; it never
# places one and never moves money.
#
# Secret the newsletter pipeline sends as "Authorization: Bearer <secret>" to
# POST /api/spare-change/ingest and POST /api/spare-change/admin/settle. Use at
# least 24 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset (or shorter than 24 characters), the ingest route answers 503 and is off.
# On the Mac that runs the pipeline the same value lives in the Keychain, never in
# a file:  security add-generic-password -s spare-change-ingest -a spare-change -w
SPARE_CHANGE_INGEST_SECRET=
# Youngest age that can earn a daily reward, whatever the ticket. Default 21.
# A ticket's own minimum (21 for sportsbooks, 18 for ProphetX, Kalshi and
# Polymarket) always applies as well.
SPARE_CHANGE_REWARD_MIN_AGE=
# Referrals: extra reward days a member gets for each friend whose first slip is
# verified (default 5), and how many friends count (default 5).
SPARE_CHANGE_REFERRAL_DAYS_PER_FRIEND=
SPARE_CHANGE_REFERRAL_MAX_FRIENDS=
# The admin routes under /api/spare-change/admin/ use the same gate as
# /api/admin/*: a signed-in session whose email is in ADMIN_EMAILS.
